class A {

	public A() {}

	public int somme(int a, int b) {
		int c = 0;
		c = a + b;
		return c;
	}

	public int produit(int a, int b) {
		return a * b;
	}
}

public class Main {

	public static void main(String[] args) {
		A a = new A();
		print a.somme(4, 5);
		print a.produit(3, 6);
	}
}
